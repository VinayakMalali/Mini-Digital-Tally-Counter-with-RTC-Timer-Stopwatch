/* ============================================================
 * MAIN
 * ============================================================ */

int main(void)
{
    HAL_Init();

    SystemClock_Config();

    MX_GPIO_Init();

    MX_I2C1_Init();

    MX_RTC_Init();


    /* Motor OFF */
    Motor_Off();


    /* Initialize HT1621 */
    HT1621_Init();


    /* Load saved tally */
    tallyCount = EEPROM_LoadTally();


    /* Initial display */
    LCD_ShowNumber(tallyCount);


    lastTick = HAL_GetTick();


    while (1)
    {
        switch (currentMode)
        {
            case MODE_TALLY:

                RunTallyMode();

                break;


            case MODE_STOPWATCH:

                RunStopwatchMode();

                break;


            case MODE_TIMER:

                RunTimerMode();

                break;


            case MODE_CLOCK:

                RunClockMode();

                break;


            default:

                currentMode = MODE_TALLY;

                break;
        }
    }
}


/* ============================================================
 * HT1621
 * ============================================================ */

/*
 * Send one bit.
 */

static void HT1621_WriteBit(uint8_t bit)
{
    HAL_GPIO_WritePin(
        HT_DATA_PORT,
        HT_DATA_PIN,
        bit ? GPIO_PIN_SET : GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        HT_WR_PORT,
        HT_WR_PIN,
        GPIO_PIN_SET
    );

    HAL_GPIO_WritePin(
        HT_WR_PORT,
        HT_WR_PIN,
        GPIO_PIN_RESET
    );
}


/*
 * Send multiple bits MSB first.
 */

static void HT1621_WriteBits(uint16_t data,
                             uint8_t numberOfBits)
{
    for (int8_t i = numberOfBits - 1; i >= 0; i--)
    {
        HT1621_WriteBit(
            (data >> i) & 0x01
        );
    }
}


/*
 * HT1621 command.
 *
 * Command format:
 *
 * 100 + 8-bit command + don't care
 */

void HT1621_Command(uint16_t command)
{
    HAL_GPIO_WritePin(
        HT_CS_PORT,
        HT_CS_PIN,
        GPIO_PIN_RESET
    );


    HT1621_WriteBits(
        0b100,
        3
    );


    HT1621_WriteBits(
        command,
        8
    );


    HT1621_WriteBit(0);


    HAL_GPIO_WritePin(
        HT_CS_PORT,
        HT_CS_PIN,
        GPIO_PIN_SET
    );
}


/*
 * Write HT1621 RAM.
 *
 * ID = 101
 * Address = 6 bits
 * Data = 4 bits
 */

void HT1621_WriteRAM(uint8_t address,
                     uint8_t data)
{
    HAL_GPIO_WritePin(
        HT_CS_PORT,
        HT_CS_PIN,
        GPIO_PIN_RESET
    );


    HT1621_WriteBits(
        0b101,
        3
    );


    HT1621_WriteBits(
        address & 0x3F,
        6
    );


    HT1621_WriteBits(
        data & 0x0F,
        4
    );


    HAL_GPIO_WritePin(
        HT_CS_PORT,
        HT_CS_PIN,
        GPIO_PIN_SET
    );
}


/*
 * Initialize HT1621.
 */

void HT1621_Init(void)
{
    HAL_GPIO_WritePin(
        HT_CS_PORT,
        HT_CS_PIN,
        GPIO_PIN_SET
    );

    HAL_GPIO_WritePin(
        HT_WR_PORT,
        HT_WR_PIN,
        GPIO_PIN_SET
    );


    /*
     * SYS EN
     *
     * 0000 0001
     */

    HT1621_Command(0x01);


    /*
     * RC 256 kHz
     *
     * 0001 10xx
     *
     * 0x18
     */

    HT1621_Command(0x18);


    /*
     * 1/3 bias + 4 commons
     *
     * 0010 10x1
     *
     * 0x29
     */

    HT1621_Command(0x29);


    /*
     * LCD ON
     */

    HT1621_Command(0x03);


    HT1621_Clear();
}


/*
 * Clear HT1621 RAM.
 */

void HT1621_Clear(void)
{
    for (uint8_t address = 0;
         address < 32;
         address++)
    {
        HT1621_WriteRAM(
            address,
            0x00
        );
    }
}


/* ============================================================
 * LCD
 * ============================================================ */

void LCD_Clear(void)
{
    HT1621_Clear();
}


/*
 * This routine assumes the LCD mapping:
 *
 * LCD:
 *
 * COM0 → HT1621 COM0
 * COM1 → HT1621 COM1
 * COM2 → HT1621 COM2
 * COM3 → HT1621 COM3
 *
 * SEG0...SEG7 → LCD segment groups
 *
 * IMPORTANT:
 * The exact segment orientation must be verified
 * on the physical LCD datasheet.
 */

void LCD_WriteDigit(uint8_t digit,
                    uint8_t value,
                    uint8_t colon)
{
    if (digit > 3)
        return;

    if (value > 9)
        return;


    uint8_t pattern =
        sevenSegment[value];


    /*
     * Two SEG addresses per digit.
     */

    uint8_t segA =
        digit * 2;

    uint8_t segB =
        segA + 1;


    uint8_t dataA = 0;
    uint8_t dataB = 0;


    /*
     * Segment mapping:
     *
     * A
     * ---
     * F   B
     * ---
     * E   C
     * ---
     * D
     *
     * Pattern:
     *
     * bit0 = A
     * bit1 = B
     * bit2 = C
     * bit3 = D
     * bit4 = E
     * bit5 = F
     * bit6 = G
     */

    if (pattern & (1 << 3))
        dataA |= (1 << 0);       // D

    if (pattern & (1 << 4))
        dataA |= (1 << 1);       // E

    if (pattern & (1 << 6))
        dataA |= (1 << 2);       // G

    if (pattern & (1 << 5))
        dataA |= (1 << 3);       // F


    if (pattern & (1 << 2))
        dataB |= (1 << 0);       // C

    if (pattern & (1 << 1))
        dataB |= (1 << 1);       // B

    if (pattern & (1 << 0))
        dataB |= (1 << 2);       // A


    /*
     * Colon / DP.
     *
     * Your LCD has DP positions.
     *
     * This may need to be changed after
     * testing the exact LCD matrix.
     */

    if (colon)
        dataB |= (1 << 3);


    HT1621_WriteRAM(
        segA,
        dataA
    );


    HT1621_WriteRAM(
        segB,
        dataB
    );
}


/*
 * Show 0000-9999.
 */

void LCD_ShowNumber(uint16_t number)
{
    if (number > 9999)
        number = 9999;


    uint8_t d0 =
        number / 1000;

    uint8_t d1 =
        (number / 100) % 10;

    uint8_t d2 =
        (number / 10) % 10;

    uint8_t d3 =
        number % 10;


    LCD_WriteDigit(0, d0, 0);

    LCD_WriteDigit(1, d1, 0);

    LCD_WriteDigit(2, d2, 0);

    LCD_WriteDigit(3, d3, 0);
}


/*
 * Show MM:SS.
 */

void LCD_ShowMMSS(uint32_t seconds)
{
    uint8_t minutes =
        seconds / 60;

    uint8_t sec =
        seconds % 60;


    if (minutes > 99)
        minutes = 99;


    LCD_WriteDigit(
        0,
        minutes / 10,
        0
    );


    LCD_WriteDigit(
        1,
        minutes % 10,
        1
    );


    LCD_WriteDigit(
        2,
        sec / 10,
        0
    );


    LCD_WriteDigit(
        3,
        sec % 10,
        0
    );
}


/*
 * Show HH:MM.
 */

void LCD_ShowHHMM(uint8_t hour,
                  uint8_t minute)
{
    LCD_WriteDigit(
        0,
        hour / 10,
        0
    );


    LCD_WriteDigit(
        1,
        hour % 10,
        1
    );


    LCD_WriteDigit(
        2,
        minute / 10,
        0
    );


    LCD_WriteDigit(
        3,
        minute % 10,
        0
    );
}


/* ============================================================
 * EEPROM
 * ============================================================ */

void EEPROM_SaveTally(uint16_t value)
{
    uint8_t data[3];


    data[0] =
        EEPROM_MAGIC;


    data[1] =
        value & 0xFF;


    data[2] =
        (value >> 8) & 0xFF;


    HAL_I2C_Mem_Write(
        &hi2c1,
        EEPROM_ADDRESS,
        EEPROM_MAGIC_ADDR,
        I2C_MEMADD_SIZE_8BIT,
        data,
        3,
        100
    );


    HAL_Delay(5);
}


/*
 * Read tally.
 */

uint16_t EEPROM_LoadTally(void)
{
    uint8_t data[3];


    if (HAL_I2C_Mem_Read(
            &hi2c1,
            EEPROM_ADDRESS,
            EEPROM_MAGIC_ADDR,
            I2C_MEMADD_SIZE_8BIT,
            data,
            3,
            100) != HAL_OK)
    {
        return 0;
    }


    if (data[0] != EEPROM_MAGIC)
        return 0;


    uint16_t value;


    value =
        data[1];


    value |=
        ((uint16_t)data[2] << 8);


    if (value > 9999)
        value = 0;


    return value;
}


/* ============================================================
 * MOTOR
 * ============================================================ */

void Motor_On(void)
{
    HAL_GPIO_WritePin(
        MOTOR_PORT,
        MOTOR_PIN,
        GPIO_PIN_SET
    );

    motorActive = 1;
}


void Motor_Off(void)
{
    HAL_GPIO_WritePin(
        MOTOR_PORT,
        MOTOR_PIN,
        GPIO_PIN_RESET
    );

    motorActive = 0;
}


void Motor_Vibrate(uint32_t time_ms)
{
    Motor_On();

    HAL_Delay(time_ms);

    Motor_Off();
}


/* ============================================================
 * BUTTON FUNCTIONS
 * ============================================================ */

uint8_t ButtonIsPressed(GPIO_TypeDef *port,
                        uint16_t pin)
{
    return
        (HAL_GPIO_ReadPin(
            port,
            pin
        ) == GPIO_PIN_RESET);
}


/*
 * Short press detection.
 */

uint8_t ButtonWasShortPressed(GPIO_TypeDef *port,
                              uint16_t pin)
{
    if (!ButtonIsPressed(port, pin))
        return 0;


    HAL_Delay(DEBOUNCE_MS);


    if (!ButtonIsPressed(port, pin))
        return 0;


    uint32_t start =
        HAL_GetTick();


    while (ButtonIsPressed(port, pin))
    {
        if ((HAL_GetTick() - start)
             >= LONG_PRESS_MS)
        {
            return 0;
        }

        HAL_Delay(5);
    }


    HAL_Delay(DEBOUNCE_MS);


    return 1;
}


/*
 * Long press detection.
 */

uint8_t ButtonWasLongPressed(GPIO_TypeDef *port,
                             uint16_t pin)
{
    if (!ButtonIsPressed(port, pin))
        return 0;


    HAL_Delay(DEBOUNCE_MS);


    if (!ButtonIsPressed(port, pin))
        return 0;


    uint32_t start =
        HAL_GetTick();


    while (ButtonIsPressed(port, pin))
    {
        if ((HAL_GetTick() - start)
             >= LONG_PRESS_MS)
        {
            /*
             * Wait until button released.
             */

            while (ButtonIsPressed(port, pin))
            {
                HAL_Delay(5);
            }

            HAL_Delay(DEBOUNCE_MS);

            return 1;
        }

        HAL_Delay(5);
    }


    return 0;
}


/* ============================================================
 * TALLY MODE
 * ============================================================ */

void RunTallyMode(void)
{
    /*
     * BIG SHORT
     * Count +1
     */

    if (ButtonWasShortPressed(
            BIG_BUTTON_PORT,
            BIG_BUTTON_PIN))
    {
        tallyCount++;


        if (tallyCount > 9999)
            tallyCount = 0;


        LCD_ShowNumber(
            tallyCount
        );


        EEPROM_SaveTally(
            tallyCount
        );
    }


    /*
     * SMALL LONG
     * Tally → Stopwatch
     */

    if (ButtonWasLongPressed(
            SMALL_BUTTON_PORT,
            SMALL_BUTTON_PIN))
    {
        currentMode =
            MODE_STOPWATCH;


        stopwatchRunning = 0;

        stopwatchSeconds = 0;

        LCD_ShowMMSS(0);

        lastTick =
            HAL_GetTick();

        return;
    }


    /*
     * SMALL SHORT
     * Reset tally
     */

    if (ButtonWasShortPressed(
            SMALL_BUTTON_PORT,
            SMALL_BUTTON_PIN))
    {
        tallyCount = 0;


        LCD_ShowNumber(
            tallyCount
        );


        EEPROM_SaveTally(
            tallyCount
        );
    }
}


/* ============================================================
 * STOPWATCH MODE
 * ============================================================ */

void RunStopwatchMode(void)
{
    /*
     * BIG SHORT
     * Start / Pause / Resume
     */

    if (ButtonWasShortPressed(
            BIG_BUTTON_PORT,
            BIG_BUTTON_PIN))
    {
        stopwatchRunning =
            !stopwatchRunning;


        lastTick =
            HAL_GetTick();
    }


    /*
     * SMALL LONG
     * Stopwatch → Timer
     */

    if (ButtonWasLongPressed(
            SMALL_BUTTON_PORT,
            SMALL_BUTTON_PIN))
    {
        stopwatchRunning = 0;

        timerRunning = 0;

        timerSeconds = 0;

        currentMode =
            MODE_TIMER;


        LCD_ShowMMSS(0);

        return;
    }


    /*
     * SMALL SHORT
     * Reset stopwatch
     */

    if (ButtonWasShortPressed(
            SMALL_BUTTON_PORT,
            SMALL_BUTTON_PIN))
    {
        stopwatchRunning = 0;

        stopwatchSeconds = 0;


        LCD_ShowMMSS(0);

        return;
    }


    /*
     * Stopwatch timing
     */

    if (stopwatchRunning)
    {
        uint32_t now =
            HAL_GetTick();


        if ((now - lastTick) >= 1000)
        {
            uint32_t elapsed =
                (now - lastTick) / 1000;


            lastTick +=
                elapsed * 1000;


            stopwatchSeconds +=
                elapsed;


            /*
             * 99:59 maximum
             */

            if (stopwatchSeconds >= 6000)
            {
                stopwatchSeconds = 0;
            }


            LCD_ShowMMSS(
                stopwatchSeconds
            );
        }
    }
}


/* ============================================================
 * TIMER MODE
 * ============================================================ */

void RunTimerMode(void)
{
    /*
     * SETTING MODE
     */

    if (!timerRunning)
    {
        /*
         * BIG SHORT
         * +1 minute
         */

        if (ButtonWasShortPressed(
                BIG_BUTTON_PORT,
                BIG_BUTTON_PIN))
        {
            timerSeconds += 60;


            if (timerSeconds > 99 * 60)
                timerSeconds = 0;


            LCD_ShowMMSS(
                timerSeconds
            );
        }


        /*
         * SMALL LONG
         * Timer → Clock
         */

        if (ButtonWasLongPressed(
                SMALL_BUTTON_PORT,
                SMALL_BUTTON_PIN))
        {
            currentMode =
                MODE_CLOCK;


            return;
        }


        /*
         * SMALL SHORT
         * Start timer
         */

        if (ButtonWasShortPressed(
                SMALL_BUTTON_PORT,
                SMALL_BUTTON_PIN))
        {
            if (timerSeconds > 0)
            {
                timerRunning = 1;

                lastTick =
                    HAL_GetTick();
            }
        }
    }


    /*
     * TIMER RUNNING
     */

    else
    {
        /*
         * BIG SHORT
         * Pause
         */

        if (ButtonWasShortPressed(
                BIG_BUTTON_PORT,
                BIG_BUTTON_PIN))
        {
            timerRunning = 0;

            return;
        }


        /*
         * SMALL SHORT
         * Reset
         */

        if (ButtonWasShortPressed(
                SMALL_BUTTON_PORT,
                SMALL_BUTTON_PIN))
        {
            timerRunning = 0;

            timerSeconds = 0;

            LCD_ShowMMSS(0);

            return;
        }


        /*
         * Countdown
         */

        uint32_t now =
            HAL_GetTick();


        if ((now - lastTick) >= 1000)
        {
            uint32_t elapsed =
                (now - lastTick) / 1000;


            lastTick +=
                elapsed * 1000;


            if (timerSeconds > elapsed)
            {
                timerSeconds -= elapsed;
            }
            else
            {
                timerSeconds = 0;
            }


            LCD_ShowMMSS(
                timerSeconds
            );


            /*
             * Timer finished
             */

            if (timerSeconds == 0)
            {
                timerRunning = 0;


                /*
                 * Silent vibration alert
                 */

                Motor_Vibrate(1000);
            }
        }
    }
}


/* ============================================================
 * CLOCK MODE
 * ============================================================ */

void RunClockMode(void)
{
    RTC_TimeTypeDef currentTime;


    /*
     * Read RTC time
     */

    HAL_RTC_GetTime(
        &hrtc,
        &currentTime,
        RTC_FORMAT_BIN
    );


    /*
     * Read date after time.
     *
     * Required by STM32 RTC HAL
     */

    RTC_DateTypeDef currentDate;

    HAL_RTC_GetDate(
        &hrtc,
        &currentDate,
        RTC_FORMAT_BIN
    );


    /*
     * Display HH:MM
     */

    LCD_ShowHHMM(
        currentTime.Hours,
        currentTime.Minutes
    );


    /*
     * SMALL LONG
     *
     * Clock → Tally
     */

    if (ButtonWasLongPressed(
            SMALL_BUTTON_PORT,
            SMALL_BUTTON_PIN))
    {
        currentMode =
            MODE_TALLY;


        LCD_ShowNumber(
            tallyCount
        );
    }
}


