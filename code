 * ============================================================ */

#define EEPROM_ADDRESS        (0x50 << 1)

#define EEPROM_MAGIC_ADDR     0x00
#define EEPROM_TALLY_L_ADDR   0x01
#define EEPROM_TALLY_H_ADDR   0x02

#define EEPROM_MAGIC           0xA5


/* ============================================================
 * BUTTON TIMING
 * ============================================================ */

#define DEBOUNCE_MS            30
#define LONG_PRESS_MS          1000


/* ============================================================
 * DEVICE MODES
 * ============================================================ */

typedef enum
{
    MODE_TALLY = 0,
    MODE_STOPWATCH,
    MODE_TIMER,
    MODE_CLOCK

} DeviceMode;


/* ============================================================
 * GLOBAL VARIABLES
 * ============================================================ */

DeviceMode currentMode = MODE_TALLY;

uint16_t tallyCount = 0;

uint32_t stopwatchSeconds = 0;
uint8_t stopwatchRunning = 0;

uint32_t timerSeconds = 0;
uint8_t timerRunning = 0;

uint32_t lastTick = 0;

uint8_t motorActive = 0;


/* ============================================================
 * 7 SEGMENT TABLE
 * ============================================================ */

const uint8_t sevenSegment[10] =
{
    0x3F,       // 0
    0x06,       // 1
    0x5B,       // 2
    0x4F,       // 3
    0x66,       // 4
    0x6D,       // 5
    0x7D,       // 6
    0x07,       // 7
    0x7F,       // 8
    0x6F        // 9
};


